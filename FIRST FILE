<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Money Hub - Smart Shop Management</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js for Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts: Hind Siliguri & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Hind Siliguri', 'Inter', sans-serif;
            background-color: #f1f5f9;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.8; }
            100% { transform: scale(1.4); opacity: 0; }
        }
        .voice-pulse::before {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 9999px;
            background-color: #ef4444;
            animation: pulse-ring 1.5s infinite;
            z-index: -1;
        }
    </style>
</head>
<body class="text-slate-800 antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Custom Notification / Toast Box -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

    <!-- Custom Modal Overlay -->
    <div id="modal-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden flex items-center justify-center p-4">
        <div id="modal-content" class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 transform transition-all scale-95 opacity-0">
            <!-- Dynamic Modal Content -->
        </div>
    </div>

    <!-- ==================== 1. LOGIN / SHOP ACCESS SCREEN ==================== -->
    <div id="auth-screen" class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-indigo-900 via-slate-900 to-emerald-950">
        <div class="bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl max-w-md w-full p-8 border border-white/20">
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-gradient-to-tr from-indigo-600 to-emerald-500 rounded-2xl mx-auto flex items-center justify-center text-white text-3xl shadow-lg mb-4">
                    <i class="fa-solid fa-wallet"></i>
                </div>
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Money Hub</h1>
                <p class="text-slate-500 text-sm mt-1">স্মার্ট দোকান ও হিসাব ব্যবস্থাপনা সফটওয়্যার</p>
            </div>

            <!-- Tabs for New Shop vs Existing Code -->
            <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-xl mb-6">
                <button onclick="switchAuthTab('new')" id="tab-new" class="py-2.5 text-sm font-semibold rounded-lg bg-white text-indigo-600 shadow-sm transition">নতুন দোকান রেজিস্ট্রেশন</button>
                <button onclick="switchAuthTab('code')" id="tab-code" class="py-2.5 text-sm font-semibold rounded-lg text-slate-600 hover:text-slate-900 transition">কোড দিয়ে লগইন</button>
            </div>

            <!-- New Shop Registration Form -->
            <form id="form-new-shop" onsubmit="handleNewShop(event)" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">দোকানের নাম</label>
                    <input type="text" id="reg-shop-name" required placeholder="যেমন: ভাই ভাই স্টোর" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">মোবাইল নাম্বার</label>
                    <input type="tel" id="reg-phone" required placeholder="017XXXXXXXX" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">সিকিউরিটি পিন (ভুল এন্ট্রি ডিলিট করার জন্য)</label>
                    <input type="password" id="reg-pin" required maxlength="4" pattern="\d{4}" placeholder="৪ সংখ্যার পিন (যেমন: 1234)" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none">
                </div>
                <button type="submit" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/30 transition flex items-center justify-center gap-2">
                    <span>কোড তৈরি করুন ও প্রবেশ করুন</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <!-- Login with Management Code Form -->
            <form id="form-code-login" onsubmit="handleCodeLogin(event)" class="space-y-4 hidden">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">App Management Code দিন</label>
                    <input type="text" id="login-shop-code" required placeholder="যেমন: MH-8492" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none uppercase font-mono text-center text-lg tracking-widest">
                </div>
                <p class="text-xs text-slate-500 text-center">নতুন বা পুরনো যেকোনো মোবাইলে এই কোড ব্যবহার করে দোকানের সব তথ্য ওপেন করতে পারবেন।</p>
                <button type="submit" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-lg shadow-emerald-500/30 transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-unlock-keyhole"></i>
                    <span>দোকান ওপেন করুন</span>
                </button>
                <div class="pt-2 text-center">
                    <button type="button" onclick="loadDemoShop()" class="text-xs text-indigo-600 font-semibold hover:underline">ডেমো দোকান (Code: MH-DEMO) দিয়ে টেস্ট করুন</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== 2. MAIN APPLICATION SCREEN ==================== -->
    <div id="app-screen" class="hidden min-h-screen flex flex-col">
        
        <!-- Top Navigation Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
            <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
                <!-- Brand & Shop Info -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white text-xl shadow">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 id="header-shop-name" class="font-bold text-lg text-slate-900 leading-none">Money Hub</h1>
                            <span id="header-shop-code" onclick="copyShopCode()" title="কপি করতে ক্লিক করুন" class="cursor-pointer px-2 py-0.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-md text-xs font-mono font-bold flex items-center gap-1">
                                <span>MH-DEMO</span> <i class="fa-regular fa-copy"></i>
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 mt-0.5">সিকিউরিটি পিন: <span class="font-mono font-semibold" id="header-pin-hint">****</span></p>
                    </div>
                </div>

                <!-- Fix vs Unfix Price Mode Toggle (Crucial Feature from Note) -->
                <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200">
                    <button onclick="setPriceMode('fix')" id="btn-mode-fix" class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-indigo-600 text-white shadow">
                        <i class="fa-solid fa-lock"></i> Price Fix (এক দর)
                    </button>
                    <button onclick="setPriceMode('unfix')" id="btn-mode-unfix" class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900">
                        <i class="fa-solid fa-sliders"></i> Unfix (দামাদামি)
                    </button>
                </div>

                <!-- Low Stock Alert Bell & Logout -->
                <div class="flex items-center gap-2">
                    <button onclick="switchTab('alerts')" class="relative p-2.5 rounded-xl bg-amber-50 text-amber-600 hover:bg-amber-100 border border-amber-200 transition" title="কম স্টক অ্যালার্ট">
                        <i class="fa-solid fa-bell"></i>
                        <span id="alert-badge" class="hidden absolute -top-1 -right-1 w-5 h-5 bg-red-600 text-white text-[10px] font-bold rounded-full flex items-center justify-center">0</span>
                    </button>
                    <button onclick="logoutShop()" class="p-2.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-red-50 hover:text-red-600 transition" title="লগআউট">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <div class="max-w-7xl mx-auto px-4 flex overflow-x-auto gap-1 border-t border-slate-100 pt-1">
                <button onclick="switchTab('pos')" id="nav-pos" class="nav-btn px-4 py-2.5 text-sm font-bold border-b-2 border-indigo-600 text-indigo-600 whitespace-nowrap flex items-center gap-2">
                    <i class="fa-solid fa-cash-register"></i> বিক্রি ও হিসাব (POS)
                </button>
                <button onclick="switchTab('inventory')" id="nav-inventory" class="nav-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap flex items-center gap-2">
                    <i class="fa-solid fa-boxes-stacked"></i> প্রোডাক্ট ও স্টক
                </button>
                <button onclick="switchTab('analytics')" id="nav-analytics" class="nav-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap flex items-center gap-2">
                    <i class="fa-solid fa-chart-line"></i> চার্ট ও জনপ্রিয়তা
                </button>
                <button onclick="switchTab('alerts')" id="nav-alerts" class="nav-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap flex items-center gap-2">
                    <i class="fa-solid fa-triangle-exclamation"></i> স্টক অ্যালার্ট
                </button>
                <button onclick="switchTab('summary')" id="nav-summary" class="nav-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap flex items-center gap-2">
                    <i class="fa-solid fa-file-invoice-dollar"></i> Summary (মোট হিসাব)
                </button>
            </div>
        </header>

        <!-- Main Content Container -->
        <main class="flex-1 max-w-7xl w-full mx-auto p-4 space-y-6">

            <!-- ==================== TAB 1: POS & SALES TABLE ==================== -->
            <section id="view-pos" class="space-y-6">
                
                <!-- Mode Info Banner -->
                <div id="mode-banner" class="p-3 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-800 text-sm flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-circle-info text-indigo-600"></i>
                        <span id="mode-banner-text"><strong>Price Fix মোড চালু আছে:</strong> আগে থেকে সেট করা দামে সরাসরি বিক্রি হবে।</span>
                    </div>
                    <span class="text-xs font-semibold px-2 py-0.5 bg-white rounded border border-indigo-200">Active Mode</span>
                </div>

                <!-- Quick Sell & Action Bar (Scan, Voice, Product Select) -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    
                    <!-- Left: Sell Input Card -->
                    <div class="lg:col-span-5 glass-card rounded-2xl p-5 shadow-sm space-y-4">
                        <div class="flex items-center justify-between">
                            <h2 class="font-bold text-lg text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-cart-plus text-indigo-600"></i> প্রোডাক্ট বিক্রি করুন
                            </h2>
                            <!-- Scan & Voice Buttons -->
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="openScannerModal()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 shadow transition">
                                    <i class="fa-solid fa-camera"></i> Scan (স্ক্যান)
                                </button>
                                <button type="button" id="voice-btn" onclick="startVoiceRecognition()" class="relative px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 shadow transition">
                                    <i class="fa-solid fa-microphone"></i> Voice
                                </button>
                            </div>
                        </div>

                        <!-- Search / Select Product -->
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">প্রোডাক্ট বা কোড নির্বাচন করুন</label>
                            <div class="relative">
                                <input type="text" id="pos-search-input" oninput="filterPosProducts()" placeholder="প্রোডাক্টের নাম বা কোড লিখুন অথবা Voice বলুন..." class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm">
                                <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400"></i>
                            </div>
                            <!-- Dropdown / Quick Pills -->
                            <div id="pos-product-pills" class="flex flex-wrap gap-1.5 mt-2 max-h-28 overflow-y-auto p-1">
                                <!-- Filled by JS -->
                            </div>
                        </div>

                        <!-- Selected Product Details Box -->
                        <div id="selected-product-box" class="hidden p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
                            <div class="flex items-center justify-between border-b border-slate-200 pb-2">
                                <div class="flex items-center gap-3">
                                    <div id="sel-prod-icon" class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-2xl">
                                        📦
                                    </div>
                                    <div>
                                        <h3 id="sel-prod-name" class="font-bold text-slate-900">Product Name</h3>
                                        <p class="text-xs text-slate-500">কোড: <span id="sel-prod-code" class="font-mono font-bold text-slate-700">P01</span> | স্টক আছে: <span id="sel-prod-stock" class="font-bold text-emerald-600">10</span> পিচ</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <span class="text-[10px] uppercase font-bold text-slate-400 block">কেনা দাম ( গোপন )</span>
                                    <span id="sel-prod-buy" class="font-mono font-bold text-slate-600">৳ 0</span>
                                </div>
                            </div>

                            <!-- Quantity, Selling Price & Extra Expense -->
                            <div class="grid grid-cols-3 gap-2">
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1">পরিমাণ (Pic)</label>
                                    <input type="number" id="sell-qty" value="1" min="1" oninput="checkLossWarning()" class="w-full px-3 py-2 rounded-lg border border-slate-300 font-bold text-center outline-none focus:border-indigo-500">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1">বিক্রি দাম (প্রতি পিচ)</label>
                                    <input type="number" id="sell-price" oninput="checkLossWarning()" class="w-full px-3 py-2 rounded-lg border border-slate-300 font-bold text-center outline-none focus:border-indigo-500">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1">খরচ (যদি থাকে)</label>
                                    <input type="number" id="sell-expense" value="0" min="0" oninput="checkLossWarning()" class="w-full px-3 py-2 rounded-lg border border-slate-300 font-bold text-center outline-none focus:border-indigo-500">
                                </div>
                            </div>

                            <!-- Loss Warning Alert (From Note: কেনা দামের কম বা সমান হলে Warning দিবে) -->
                            <div id="loss-warning-box" class="hidden p-2.5 rounded-lg bg-red-50 border border-red-300 text-red-700 text-xs flex items-center gap-2 animate-pulse">
                                <i class="fa-solid fa-triangle-exclamation text-base"></i>
                                <span><strong>সতর্কতা (Warning):</strong> আপনি কেনা দামের সমান বা তার চেয়ে কম দামে বিক্রি করছেন! এতে লস (Loss) হবে।</span>
                            </div>

                            <button type="button" onclick="confirmSale()" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-md transition flex items-center justify-center gap-2">
                                <i class="fa-solid fa-check-circle"></i>
                                <span>বিক্রি সম্পন্ন করুন (Sold)</span>
                            </button>
                        </div>
                    </div>

                    <!-- Right: Exact Table Structure from User's Notebook -->
                    <div class="lg:col-span-7 glass-card rounded-2xl p-5 shadow-sm flex flex-col">
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                            <div>
                                <h2 class="font-bold text-lg text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-table-list text-emerald-600"></i> বিক্রির তালিকা (Sales List)
                                </h2>
                                <p class="text-xs text-slate-500">কোডে ক্লিক করলে প্রোডাক্টের ছবি, স্টক ও জনপ্রিয়তা চার্ট দেখা যাবে।</p>
                            </div>
                            <span class="text-xs bg-red-50 text-red-600 border border-red-200 px-2.5 py-1 rounded-lg font-semibold">
                                * লাল রঙ = লস বা কেনা দামে বিক্রি
                            </span>
                        </div>

                        <!-- Notebook Table: Pic | Product name | Code | Buying Prize | Selling Prize | Profit/Lose | খরচ | Time -->
                        <div class="overflow-x-auto flex-1 border border-slate-200 rounded-xl">
                            <table class="w-full text-left border-collapse text-sm">
                                <thead>
                                    <tr class="bg-slate-800 text-white text-xs uppercase">
                                        <th class="p-2.5 border-r border-slate-700">Pic</th>
                                        <th class="p-2.5 border-r border-slate-700">Product Name</th>
                                        <th class="p-2.5 border-r border-slate-700">Code</th>
                                        <th class="p-2.5 border-r border-slate-700">Buying Prize</th>
                                        <th class="p-2.5 border-r border-slate-700">Selling Prize</th>
                                        <th class="p-2.5 border-r border-slate-700">Profit/Lose</th>
                                        <th class="p-2.5 border-r border-slate-700">খরচ</th>
                                        <th class="p-2.5 border-r border-slate-700">Time</th>
                                        <th class="p-2.5 text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="sales-table-body" class="divide-y divide-slate-200 bg-white">
                                    <!-- Dynamic Rows -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ==================== TAB 2: INVENTORY & ADD PRODUCT ==================== -->
            <section id="view-inventory" class="hidden space-y-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Add New Product Form -->
                    <div class="glass-card rounded-2xl p-6 shadow-sm">
                        <h2 class="font-bold text-lg text-slate-800 mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-plus-circle text-indigo-600"></i> নতুন প্রোডাক্ট যোগ করুন
                        </h2>
                        <form onsubmit="handleAddProduct(event)" class="space-y-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-600 mb-1">প্রোডাক্টের নাম</label>
                                <input type="text" id="new-prod-name" required placeholder="যেমন: Miniket Rice 5kg" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 outline-none focus:border-indigo-500">
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1">মডেল / কোড (Code)</label>
                                    <input type="text" id="new-prod-code" required placeholder="যেমন: MR-01" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 uppercase font-mono outline-none focus:border-indigo-500">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1">স্টক পরিমাণ (Pic)</label>

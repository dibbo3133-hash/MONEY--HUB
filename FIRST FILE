        function simulateScanResult(prodId) {
            closeModal();
            selectProductForSale(prodId);
            showToast("স্ক্যান সফল! প্রোডাক্ট ও নির্ধারিত দাম চলে এসেছে।", "success");
        }

        // Voice Recognition (From Note: Voice এ বলা যায় যাতে না লিখে Voice দিলেও চলে আসে)
        function startVoiceRecognition() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            const voiceBtn = document.getElementById("voice-btn");

            if (!SpeechRecognition) {
                showToast("আপনার ব্রাউজারে সরাসরি ভয়েস সাপোর্ট নেই, সার্চ বক্সে লিখুন।", "warning");
                return;
            }

            const recognition = new SpeechRecognition();
            recognition.lang = 'bn-BD'; // Supports Bengali & English product names
            recognition.interimResults = false;

            voiceBtn.classList.add("voice-pulse");
            showToast("কথা বলুন... প্রোডাক্টের নাম বা কোড বলুন", "info");

            recognition.onresult = function(event) {
                const transcript = event.results[0][0].transcript;
                document.getElementById("pos-search-input").value = transcript;
                filterPosProducts();

                // Auto select if close match
                const match = currentShop.products.find(p => 
                    p.name.toLowerCase().includes(transcript.toLowerCase()) || 
                    p.code.toLowerCase().includes(transcript.toLowerCase())
                );
                if (match) {
                    selectProductForSale(match.id);
                    showToast(`ভয়েস শনাক্ত হয়েছে: "${match.name}"`, "success");
                } else {
                    showToast(`আপনি বলেছেন: "${transcript}"`, "info");
                }
            };

            recognition.onerror = function() {
                showToast("ভয়েস বুঝতে সমস্যা হয়েছে, আবার চেষ্টা করুন।", "error");
            };

            recognition.onend = function() {
                voiceBtn.classList.remove("voice-pulse");
            };

            recognition.start();
        }

        // ==================== SALES TABLE & PIN DELETE ====================
        function renderSalesTable() {
            const tbody = document.getElementById("sales-table-body");
            tbody.innerHTML = "";

            if (currentShop.sales.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="p-6 text-center text-slate-400">এখনো কোনো প্রোডাক্ট বিক্রি হয়নি।</td></tr>`;
                return;
            }

            currentShop.sales.forEach(sale => {
                const totalBuy = sale.buyPrice * sale.pic;
                const totalSell = sale.sellPrice * sale.pic;
                const netProfitLoss = totalSell - totalBuy - (sale.expense || 0);
                const isLossOrCost = sale.sellPrice <= sale.buyPrice;

                const tr = document.createElement("tr");
                tr.className = "hover:bg-slate-50 transition";
                tr.innerHTML = `
                    <td class="p-2.5 border-r border-slate-100 font-bold text-center">${sale.pic}</td>
                    <td class="p-2.5 border-r border-slate-100 font-semibold text-slate-800">${sale.productName}</td>
                    <td class="p-2.5 border-r border-slate-100">
                        <button onclick="openProductDetailByCode('${sale.code}')" class="px-2 py-0.5 bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white font-mono font-bold rounded border border-indigo-200 transition text-xs" title="বিস্তারিত চার্ট ও ছবি দেখতে ক্লিক করুন">
                            ${sale.code}
                        </button>
                    </td>
                    <td class="p-2.5 border-r border-slate-100 font-mono text-slate-600">৳${sale.buyPrice}</td>
                    <td class="p-2.5 border-r border-slate-100 font-mono font-bold ${isLossOrCost ? 'text-red-600 bg-red-50' : 'text-slate-900'}">
                        ৳${sale.sellPrice}
                    </td>
                    <td class="p-2.5 border-r border-slate-100 font-mono font-bold ${netProfitLoss < 0 ? 'text-red-600' : 'text-emerald-600'}">
                        ${netProfitLoss >= 0 ? '+' : ''}৳${netProfitLoss}
                    </td>
                    <td class="p-2.5 border-r border-slate-100 font-mono text-slate-500">৳${sale.expense || 0}</td>
                    <td class="p-2.5 border-r border-slate-100 text-xs text-slate-500 whitespace-nowrap">${sale.time}</td>
                    <td class="p-2.5 text-center">
                        <button onclick="promptPinToDelete(${sale.id})" class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition" title="পিন দিয়ে ডিলিট করুন">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Delete Wrong Sale with Separate PIN (From Note: ভুলকরে sold করলে remove করতে আলাদা Pin থাকবে)
        function promptPinToDelete(saleId) {
            showModal(`
                <div class="space-y-4 text-center">
                    <div class="w-14 h-14 bg-red-100 text-red-600 rounded-full mx-auto flex items-center justify-center text-2xl">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h3 class="font-bold text-lg text-slate-900">ভুল বিক্রি ডিলিট করুন</h3>
                    <p class="text-xs text-slate-500">তালিকা থেকে এই এন্ট্রি রিমুভ করতে আপনার ৪ সংখ্যার সিকিউরিটি পিন দিন:</p>
                    <input type="password" id="verify-delete-pin" maxlength="4" placeholder="****" class="w-40 mx-auto block px-4 py-2.5 text-center text-xl font-mono tracking-widest rounded-xl border border-slate-300 focus:border-red-500 outline-none">
                    <div class="flex gap-2 pt-2">
                        <button onclick="closeModal()" class="flex-1 py-2.5 bg-slate-100 text-slate-700 font-bold rounded-xl">বাতিল</button>
                        <button onclick="confirmDeleteWithPin(${saleId})" class="flex-1 py-2.5 bg-red-600 text-white font-bold rounded-xl shadow">ডিলিট করুন</button>
                    </div>
                </div>
            `);
        }

        function confirmDeleteWithPin(saleId) {
            const enteredPin = document.getElementById("verify-delete-pin").value;
            if (enteredPin !== currentShop.pin) {
                showToast("ভুল পিন! এন্ট্রি ডিলিট করা সম্ভব হয়নি।", "error");
                return;
            }

            const saleIndex = currentShop.sales.findIndex(s => s.id === saleId);
            if (saleIndex > -1) {
                const sale = currentShop.sales[saleIndex];
                // Restore stock
                const prod = currentShop.products.find(p => p.code === sale.code);
                if (prod) {
                    prod.stock += sale.pic;
                    prod.soldCount = Math.max(0, prod.soldCount - sale.pic);
                }
                currentShop.sales.splice(saleIndex, 1);
                saveShopData();
                closeModal();
                refreshAllViews();
                showToast("পিন যাচাই সফল! এন্ট্রি রিমুভ ও স্টক ফেরত দেওয়া হয়েছে।", "success");
            }
        }


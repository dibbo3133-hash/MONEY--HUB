                { id: 5, code: "SG-05", name: "চিনি প্যাকেট (১ কেজি)", buyPrice: 125, sellPrice: 135, stock: 25, soldCount: 40, icon: "📦" }
            ],
            sales: [
                { id: 101, pic: 2, productName: "সয়াবিন তেল (৫ লিটার)", code: "SO-02", buyPrice: 780, sellPrice: 820, expense: 10, time: "10:15 AM", date: new Date().toDateString() },
                { id: 102, pic: 1, productName: "প্রিমিয়াম কটন টি-শার্ট", code: "TS-03", buyPrice: 250, sellPrice: 240, expense: 0, time: "11:30 AM", date: new Date().toDateString() }, // Loss example (Red)
                { id: 103, pic: 3, productName: "চিনি প্যাকেট (১ কেজি)", code: "SG-05", buyPrice: 125, sellPrice: 135, expense: 0, time: "12:45 PM", date: new Date().toDateString() }
            ]
        };

        let currentShop = null;
        let selectedProduct = null;
        let salesTimeChartInstance = null;
        let popularityChartInstance = null;

        // ==================== INITIALIZATION ====================
        window.onload = function() {
            // Ensure demo shop exists in localStorage
            if (!localStorage.getItem("moneyhub_MH-DEMO")) {
                localStorage.setItem("moneyhub_MH-DEMO", JSON.stringify(DEFAULT_DEMO_DATA));
            }
            // Check active session
            const activeCode = sessionStorage.getItem("moneyhub_active_code");
            if (activeCode) {
                const saved = localStorage.getItem("moneyhub_" + activeCode);
                if (saved) {
                    currentShop = JSON.parse(saved);
                    openAppScreen();
                }
            }
        };

        function saveShopData() {
            if (currentShop) {
                localStorage.setItem("moneyhub_" + currentShop.shopCode, JSON.stringify(currentShop));
            }
        }

        // ==================== AUTHENTICATION & SHOP CODE ====================
        function switchAuthTab(tab) {
            const newForm = document.getElementById("form-new-shop");
            const codeForm = document.getElementById("form-code-login");
            const tabNew = document.getElementById("tab-new");
            const tabCode = document.getElementById("tab-code");

            if (tab === 'new') {
                newForm.classList.remove("hidden");
                codeForm.classList.add("hidden");
                tabNew.className = "py-2.5 text-sm font-semibold rounded-lg bg-white text-indigo-600 shadow-sm transition";
                tabCode.className = "py-2.5 text-sm font-semibold rounded-lg text-slate-600 hover:text-slate-900 transition";
            } else {
                newForm.classList.add("hidden");
                codeForm.classList.remove("hidden");
                tabCode.className = "py-2.5 text-sm font-semibold rounded-lg bg-white text-emerald-600 shadow-sm transition";
                tabNew.className = "py-2.5 text-sm font-semibold rounded-lg text-slate-600 hover:text-slate-900 transition";
            }
        }

        function handleNewShop(e) {
            e.preventDefault();
            const shopName = document.getElementById("reg-shop-name").value.trim();
            const phone = document.getElementById("reg-phone").value.trim();
            const pin = document.getElementById("reg-pin").value.trim();

            // Generate unique Management Code
            const randomNum = Math.floor(1000 + Math.random() * 9000);
            const generatedCode = "MH-" + randomNum;

            currentShop = {
                shopName,
                shopCode: generatedCode,
                phone,
                pin,
                priceMode: "fix",
                products: [
                    { id: 1, code: "P-101", name: "নমুনা প্রোডাক্ট ১", buyPrice: 100, sellPrice: 120, stock: 15, soldCount: 5, icon: "📦" }
                ],
                sales: []
            };

            saveShopData();
            sessionStorage.setItem("moneyhub_active_code", generatedCode);

            // Show generated code popup
            showModal(`
                <div class="text-center space-y-4">
                    <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full mx-auto flex items-center justify-center text-3xl">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900">দোকান সফলভাবে তৈরি হয়েছে!</h3>
                    <p class="text-sm text-slate-600">আপনার App Management Code নিচে দেওয়া হলো। এই কোড দিয়ে যেকোনো মোবাইলে লগইন করতে পারবেন:</p>
                    <div class="p-3 bg-slate-100 rounded-xl font-mono text-2xl font-bold text-indigo-700 tracking-widest border border-slate-300">
                        ${generatedCode}
                    </div>
                    <button onclick="closeModal(); openAppScreen();" class="w-full py-3 bg-indigo-600 text-white font-bold rounded-xl shadow">
                        অ্যাপে প্রবেশ করুন
                    </button>
                </div>
            `);
        }

        function handleCodeLogin(e) {
            e.preventDefault();
            const code = document.getElementById("login-shop-code").value.trim().toUpperCase();
            const saved = localStorage.getItem("moneyhub_" + code);
            if (saved) {
                currentShop = JSON.parse(saved);
                sessionStorage.setItem("moneyhub_active_code", code);
                openAppScreen();
                showToast("সফলভাবে দোকানে প্রবেশ করেছেন!", "success");
            } else {
                showToast("ভুল কোড! দয়া করে সঠিক App Management Code দিন।", "error");
            }
        }

        function loadDemoShop() {
            document.getElementById("login-shop-code").value = "MH-DEMO";
            const saved = localStorage.getItem("moneyhub_MH-DEMO");
            currentShop = JSON.parse(saved);
            sessionStorage.setItem("moneyhub_active_code", "MH-DEMO");
            openAppScreen();
            showToast("ডেমো দোকানে (পিন: 1234) স্বাগতম!", "success");
        }

        function logoutShop() {
            sessionStorage.removeItem("moneyhub_active_code");
            currentShop = null;
            document.getElementById("app-screen").classList.add("hidden");
            document.getElementById("auth-screen").classList.remove("hidden");
        }

        function openAppScreen() {
            document.getElementById("auth-screen").classList.add("hidden");
            document.getElementById("app-screen").classList.remove("hidden");

            document.getElementById("header-shop-name").innerText = currentShop.shopName;
            document.getElementById("header-shop-code").innerHTML = `<span>${currentShop.shopCode}</span> <i class="fa-regular fa-copy"></i>`;
            
            setPriceMode(currentShop.priceMode || 'fix', false);
            refreshAllViews();
        }

        function copyShopCode() {
            const temp = document.createElement("input");
            temp.value = currentShop.shopCode;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand("copy");
            document.body.removeChild(temp);
            showToast(`দোকান কোড (${currentShop.shopCode}) কপি করা হয়েছে!`, "info");
        }

        // ==================== PRICE FIX VS UNFIX MODE ====================
        function setPriceMode(mode, notify = true) {
            currentShop.priceMode = mode;
            saveShopData();

            const btnFix = document.getElementById("btn-mode-fix");
            const btnUnfix = document.getElementById("btn-mode-unfix");
            const banner = document.getElementById("mode-banner");
            const bannerText = document.getElementById("mode-banner-text");
            const sellPriceInput = document.getElementById("sell-price");

            if (mode === 'fix') {
                btnFix.className = "px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-indigo-600 text-white shadow";
                btnUnfix.className = "px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900";
                banner.className = "p-3 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-800 text-sm flex items-center justify-between";
                bannerText.innerHTML = `<strong>Price Fix মোড চালু আছে:</strong> আগে থেকে সেট করা নির্দিষ্ট দামে সরাসরি বিক্রি হবে।`;
                if (selectedProduct) {
                    sellPriceInput.value = selectedProduct.sellPrice;
                    sellPriceInput.readOnly = true;
                    sellPriceInput.classList.add("bg-slate-100");
                }
                if (notify) showToast("Price Fix (এক দর) মোড চালু হয়েছে", "info");
            } else {
                btnUnfix.className = "px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-1.5 bg-amber-600 text-white shadow";
                btnFix.className = "px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900";
                banner.className = "p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-sm flex items-center justify-between";
                bannerText.innerHTML = `<strong>Unfix মোড চালু আছে:</strong> আপনি নিজে থেকে বিক্রির দাম বসাতে পারবেন (কেনা দামের কম হলে Warning দিবে)।`;
                if (selectedProduct) {
                    sellPriceInput.readOnly = false;
                    sellPriceInput.classList.remove("bg-slate-100");
                }
                if (notify) showToast("Unfix (দামাদামি) মোড চালু হয়েছে", "info");
            }
            checkLossWarning();
        }

        // ==================== NAVIGATION TABS ====================
        function switchTab(tabName) {
            const sections = ['pos', 'inventory', 'analytics', 'alerts', 'summary'];
            sections.forEach(s => {
                document.getElementById("view-" + s).classList.add("hidden");
                const btn = document.getElementById("nav-" + s);
                btn.className = "nav-btn px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap flex items-center gap-2";
            });

            document.getElementById("view-" + tabName).classList.remove("hidden");
            const activeBtn = document.getElementById("nav-" + tabName);
            activeBtn.className = "nav-btn px-4 py-2.5 text-sm font-bold border-b-2 border-indigo-600 text-indigo-600 whitespace-nowrap flex items-center gap-2";

            if (tabName === 'analytics') renderCharts();
            if (tabName === 'summary') filterSummary('today');
        }

        // ==================== POS: PRODUCT SELECTION, SCAN & VOICE ====================
        function filterPosProducts() {
            const query = document.getElementById("pos-search-input").value.toLowerCase().trim();
            const container = document.getElementById("pos-product-pills");
            container.innerHTML = "";

            const filtered = currentShop.products.filter(p => 
                p.name.toLowerCase().includes(query) || p.code.toLowerCase().includes(query)
            );

            filtered.forEach(p => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.onclick = () => selectProductForSale(p.id);
                btn.className = `px-3 py-1.5 rounded-lg text-xs font-semibold border transition flex items-center gap-1.5 ${
                    p.stock <= 0 ? 'bg-red-50 text-red-400 border-red-200 cursor-not-allowed' : 'bg-white hover:bg-indigo-50 text-slate-700 border-slate-300 shadow-xs'
                }`;
                btn.innerHTML = `<span>${p.icon}</span> <span>${p.name}</span> <span class="font-mono text-[10px] bg-slate-100 px-1 rounded">${p.code}</span>`;
                container.appendChild(btn);
            });
        }

        function selectProductForSale(prodId) {
            const prod = currentShop.products.find(p => p.id === prodId);
            if (!prod) return;
            if (prod.stock <= 0) {
                showToast("দুঃখিত! এই প্রোডাক্টটির স্টক শেষ হয়ে গেছে।", "error");
                return;
            }

            selectedProduct = prod;
            document.getElementById("selected-product-box").classList.remove("hidden");
            document.getElementById("sel-prod-icon").innerText = prod.icon;
            document.getElementById("sel-prod-name").innerText = prod.name;
            document.getElementById("sel-prod-code").innerText = prod.code;
            document.getElementById("sel-prod-stock").innerText = prod.stock;
            document.getElementById("sel-prod-buy").innerText = "৳ " + prod.buyPrice;

            const sellInput = document.getElementById("sell-price");
            sellInput.value = prod.sellPrice;
            document.getElementById("sell-qty").value = 1;
            document.getElementById("sell-qty").max = prod.stock;
            document.getElementById("sell-expense").value = 0;

            if (currentShop.priceMode === 'fix') {
                sellInput.readOnly = true;
                sellInput.classList.add("bg-slate-100");
            } else {
                sellInput.readOnly = false;
                sellInput.classList.remove("bg-slate-100");
            }
            checkLossWarning();
        }

        // Check Loss Warning (From Note: কেনা দামে বা তার থেকে কমে বিক্রি করতে চায় তাহলে Warning দিবে)
        function checkLossWarning() {
            if (!selectedProduct) return;
            const sellPrice = parseFloat(document.getElementById("sell-price").value) || 0;
            const warnBox = document.getElementById("loss-warning-box");

            if (sellPrice <= selectedProduct.buyPrice) {
                warnBox.classList.remove("hidden");
            } else {
                warnBox.classList.add("hidden");
            }
        }

        function confirmSale() {
            if (!selectedProduct) return;
            const qty = parseInt(document.getElementById("sell-qty").value) || 1;
            const sellPrice = parseFloat(document.getElementById("sell-price").value) || 0;
            const expense = parseFloat(document.getElementById("sell-expense").value) || 0;

            if (qty > selectedProduct.stock) {
                showToast("স্টকের চেয়ে বেশি পরিমাণ বিক্রি করা সম্ভব নয়!", "error");
                return;
            }
            if (sellPrice <= 0) {
                showToast("সঠিক বিক্রয় মূল্য দিন!", "error");
                return;
            }

            // Deduct stock & update soldCount
            selectedProduct.stock -= qty;
            selectedProduct.soldCount += qty;

            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            const saleRecord = {
                id: Date.now(),
                pic: qty,
                productName: selectedProduct.name,
                code: selectedProduct.code,
                buyPrice: selectedProduct.buyPrice,
                sellPrice: sellPrice,
                expense: expense,
                time: timeStr,
                date: now.toDateString()
            };

            currentShop.sales.unshift(saleRecord);
            saveShopData();

            // Notify if sold at loss/cost
            if (sellPrice <= selectedProduct.buyPrice) {
                showToast("সতর্কতা: পণ্যটি কেনা দাম বা লসে বিক্রি হয়েছে (লাল রঙে চিহ্নিত)!", "warning");
            } else {
                showToast("বিক্রি সফলভাবে তালিকায় যুক্ত হয়েছে!", "success");
            }

            document.getElementById("selected-product-box").classList.add("hidden");
            selectedProduct = null;
            refreshAllViews();
        }

        // Camera Scan Simulation (From Note: Scan option ক্লিক করলে ক্যামেরা ওপেন হবে এবং প্রোডাক্ট চিনে দাম দেখাবে)

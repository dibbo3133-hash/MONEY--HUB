            showModal(`
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <h3 class="font-bold text-lg text-slate-900 flex items-center gap-2">
                            <i class="fa-solid fa-camera text-indigo-600"></i> প্রোডাক্ট ক্যামেরা স্ক্যানার
                        </h3>
                        <button onclick="closeModal()" class="text-slate-400 hover:text-slate-700"><i class="fa-solid fa-xmark text-xl"></i></button>
                    </div>
                    <div class="relative h-44 bg-slate-900 rounded-2xl overflow-hidden flex flex-col items-center justify-center text-white border-2 border-indigo-500">
                        <div class="w-48 h-28 border-2 border-emerald-400 rounded-xl relative flex items-center justify-center">
                            <div class="w-full h-0.5 bg-red-500 animate-bounce"></div>
                        </div>
                        <p class="text-xs text-slate-300 mt-2">ক্যামেরার সামনে প্রোডাক্ট ধরুন অথবা নিচে ট্যাপ করে স্ক্যান টেস্ট করুন:</p>

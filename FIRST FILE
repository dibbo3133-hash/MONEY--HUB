        // ==================== INVENTORY MANAGEMENT ====================
        function handleAddProduct(e) {
            e.preventDefault();
            const name = document.getElementById("new-prod-name").value.trim();
            const code = document.getElementById("new-prod-code").value.trim().toUpperCase();
            const stock = parseInt(document.getElementById("new-prod-stock").value);
            const buyPrice = parseFloat(document.getElementById("new-prod-buy").value);
            const sellPrice = parseFloat(document.getElementById("new-prod-sell").value);
            const icon = document.getElementById("new-prod-icon").value;

            if (currentShop.products.some(p => p.code === code)) {
                showToast("এই কোডটি ইতিমধ্যে ব্যবহৃত হয়েছে! অন্য কোড দিন।", "error");
                return;
            }

            currentShop.products.push({
                id: Date.now(),
                code,
                name,
                buyPrice,
                sellPrice,
                stock,
                soldCount: 0,
                icon
            });

            saveShopData();
            e.target.reset();
            refreshAllViews();
            showToast("নতুন প্রোডাক্

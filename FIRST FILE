                { id: 1, code: "MR-01", name: "মিনিকেট চাল (৫ কেজি)", buyPrice: 320, sellPrice: 360, stock: 18, soldCount: 24, icon: "🌾" },
                { id: 2, code: "SO-02", name: "সয়াবিন তেল (৫ লিটার)", buyPrice: 780, sellPrice: 820, stock: 4, soldCount: 35, icon: "🧴" },
                { id: 3, code: "TS-03", name: "প্রিমিয়াম কটন টি-শার্ট", buyPrice: 250, sellPrice: 350, stock: 12, soldCount: 15, icon: "👕" },

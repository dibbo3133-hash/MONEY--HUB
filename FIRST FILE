    <script>
        // ==================== STATE MANAGEMENT & INITIAL DATA ====================
        const DEFAULT_DEMO_DATA = {
            shopName: "ভাই ভাই ডিজিটাল স্টোর",
            shopCode: "MH-DEMO",
            phone: "01700000000",
            pin: "1234",
            priceMode: "fix", // 'fix' or 'unfix'
